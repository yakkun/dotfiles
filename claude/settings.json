{
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "language": "Japanese",
  "theme": "dark-daltonized",
  "skipAutoPermissionPrompt": true,
  "tui": "fullscreen",
  "cleanupPeriodDays": 365,
  "spinnerTipsEnabled": false
}
